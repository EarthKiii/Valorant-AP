# Overwolf developer credentials (https://console.overwolf.com). Unsigned ow-electron apps only get game events
# in dev mode. Use either the email + API key pair, or a dev token.
OW_CLI_EMAIL=
OW_CLI_API_KEY=
# OW_DEV_KEY=

# Must match the client's --companion-port if you changed it.
# VALORANT_AP_PORT=43792

# Set to false to run without the progress window (headless, lowest overhead).
SHOW_WINDOW=true

# Agent-select overlay, drawn inside the game by Overwolf's overlay package (works in Fullscreen): a small note that
# warns when the agent you hover or lock in wouldn't count. Optional: false turns it off, and the overlay package
# then never attaches to the game.
SHOW_OVERLAY=true
# How far down the game it sits, in % of its height.
# OVERLAY_TOP=12
