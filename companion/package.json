    "start": "node scripts/build.mjs && node start.js",
    "pack": "node scripts/pack.js"
  },
  "devDependencies": {
    "@overwolf/ow-electron": "^42.11.4",
    "esbuild": "^0.28.2",
    "svelte": "^5.57.1"
  }
}
